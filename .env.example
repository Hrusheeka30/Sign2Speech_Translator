# Copy this file to ".env" and fill in your Azure keys.
# Azure AI services -> Translator  (free tier F0 available)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure AI services -> Speech  (free tier F0 available)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
